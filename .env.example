# Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=
# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=
# ID deines Discord-Servers (Entwicklermodus aktivieren)
GUILD_ID=

# Kategorie, in der neue Tickets erstellt werden
TICKET_CATEGORY_ID=
# Support-Rolle, die alle Tickets sehen darf
SUPPORT_ROLE_ID=
# Rolle, die der Verify-Button vergibt
VERIFIED_ROLE_ID=
# Kanal, in den /vouch Bewertungen postet
VOUCH_CHANNEL_ID=

# Optional: Name des Bots in Embeds
BRAND_NAME=Community Support

# Optionaler Health-Port für kostenlose Web-Hoster
PORT=3000
